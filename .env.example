# Set after deploying contracts/src/Probon.sol to Arc Mainnet.
# Leave empty until the deployed contract has been reviewed and confirmed.
VITE_PROBON_CONTRACT_ADDRESS=
VITE_PROBON_DEPLOYMENT_BLOCK=0

# Supabase browser-public configuration (never place service-role keys in VITE_* variables).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_ARC_CHAIN_ID=5042
VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
VITE_PLATFORM_FEE_RECIPIENT=0x5Bce25397eEfbc76f6479e6838c00a5115dbEA4c
